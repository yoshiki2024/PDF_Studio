{
  "manifest_version": 3,
  "name": "PDF Studio - 完全ローカルPDF加工ツール",
  "version": "1.0.0",
  "description": "インストール不要・外部通信なし。ブラウザ完結で安全にPDFの結合・分割・回転・テキスト編集・ハイライト・墨消しを行える高機能PDFツール",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PDF Studio を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
